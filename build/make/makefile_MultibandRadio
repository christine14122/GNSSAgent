# Go selection is shared with makefile: PATH, then /opt/go, then res. No retry after build failure.
ifneq ($(words $(MAKEFILE_LIST)),1)
$(error Makefile paths do not support whitespace)
endif
MAKEFILE_PATH := $(lastword $(MAKEFILE_LIST))
ifeq ($(filter /%,$(MAKEFILE_PATH)),)
ifneq ($(words $(CURDIR)),1)
$(error Makefile paths do not support whitespace)
endif
endif

MAKE_DIR := $(dir $(abspath $(MAKEFILE_PATH)))
PROJECT_ROOT := $(abspath $(MAKE_DIR)/../..)
DIST_DIR := $(PROJECT_ROOT)/release
.DEFAULT_GOAL := all
.PHONY: all multiband-radio clean install

all: multiband-radio

multiband-radio:

	$(MAKE) --no-print-directory -f "$(MAKE_DIR)/makefile" multiband-radio

clean:

	rm -f "$(DIST_DIR)/GNSSAgent-MultibandRadio"

install:
	@cp ../release/GNSSAgent-MultibandRadio ./../../Bin/GNSSAgent
