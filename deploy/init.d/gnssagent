#!/bin/sh

DEFAULTS=${DEFAULTS:-/etc/default/gnssagent}
if [ -r "$DEFAULTS" ]; then
    . "$DEFAULTS"
fi

: "${GNSSAGENT_BIN:=/usr/bin/GNSSAgent}"
: "${PIDFILE:=/var/run/gnssagent.pid}"
: "${UDP_LISTEN:=127.0.0.1:29501}"
: "${TCP_LISTEN:=0.0.0.0:29501}"
: "${MAX_CONNECTIONS:=5}"
: "${MAX_REMOTE_CONNECTIONS:=4}"
: "${LOG_LEVEL:=info}"
: "${LOG_FILE:=/lib/firmware/gnssagent/log/gnssagent.log}"
: "${LOG_MAX_BYTES:=8388608}"
: "${CONSOLE_LOG:=/var/volatile/gnssagent-console.log}"

read_live_pid() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE" 2>/dev/null)
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$pid" -gt 1 ] 2>/dev/null || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    return 0
}

do_start() {
    if read_live_pid; then
        echo "GNSSAgent is already running (pid $pid)"
        return 0
    fi
    if [ ! -x "$GNSSAGENT_BIN" ]; then
        echo "GNSSAgent executable is missing or not executable: $GNSSAGENT_BIN" >&2
        return 1
    fi

    mkdir -p "$(dirname "$LOG_FILE")"
    mkdir -p "$(dirname "$CONSOLE_LOG")"
    set -- "$GNSSAGENT_BIN" \
        --udp-listen "$UDP_LISTEN" \
        --tcp-listen "$TCP_LISTEN" \
        --max-connections "$MAX_CONNECTIONS" \
        --max-remote-connections "$MAX_REMOTE_CONNECTIONS" \
        --log-level "$LOG_LEVEL" \
        --log-file "$LOG_FILE" \
        --log-max-bytes "$LOG_MAX_BYTES"
    nohup "$@" >"$CONSOLE_LOG" 2>&1 </dev/null &
    echo "$!" >"$PIDFILE"
    echo "GNSSAgent started (pid $!)"
}

do_stop() {
    if ! read_live_pid; then
        rm -f "$PIDFILE"
        echo "GNSSAgent is not running"
        return 0
    fi

    target_pid=$pid
    if ! kill -TERM "$target_pid" 2>/dev/null; then
        echo "Unable to signal GNSSAgent pid $target_pid" >&2
        return 1
    fi
    for wait_seconds in 1 2 3 4 5; do
        if ! kill -0 "$target_pid" 2>/dev/null; then
            rm -f "$PIDFILE"
            echo "GNSSAgent stopped"
            return 0
        fi
        sleep 1
    done
    echo "GNSSAgent pid $target_pid did not stop within 5 seconds" >&2
    return 1
}

do_status() {
    if read_live_pid; then
        echo "GNSSAgent is running (pid $pid)"
        return 0
    fi
    echo "GNSSAgent is not running"
    return 3
}

case "${1:-}" in
    start) do_start ;;
    stop) do_stop ;;
    restart)
        do_stop && do_start
        ;;
    status) do_status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac
